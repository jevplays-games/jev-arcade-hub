# The host injects PORT. Set the rest in the GoDaddy Settings > Environment variables panel.
PORT=3000

# Each game defaults to https://<slug>.<HUB_BASE_DOMAIN>
HUB_BASE_DOMAIN=jevplay.games
HUB_SCHEME=https

# Optional per-game overrides (full origin), e.g. for local play or a different domain:
# GAME_URL_TIC_TAC_TOE=http://localhost:8787
# GAME_URL_CONNECT_FOUR=
# GAME_URL_CHECKERS=
# GAME_URL_DOTS_AND_BOXES=
# GAME_URL_GUESS_WHO=
# GAME_URL_MASTERMIND=
# GAME_URL_MINESWEEPER=
# GAME_URL_SUDOKU=
# GAME_URL_2048=
