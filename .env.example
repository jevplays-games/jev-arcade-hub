# The host injects PORT. Set the rest in the GoDaddy Settings > Environment variables panel.
PORT=3000

# Each game defaults to https://<slug>.<HUB_BASE_DOMAIN>
HUB_BASE_DOMAIN=jevplay.games
HUB_SCHEME=https

# Rename cutover. A games.json row that still carries "legacySlug" links to the host the game answers on
# today, https://<legacySlug>.<HUB_BASE_DOMAIN>, so no card breaks while the nine games move one by one.
# Delete legacySlug from a row once https://<slug>.jevplay.games is live (deploy/REDIRECTS.md).
#
# Optional per-game overrides (full origin). They win over everything above, for local play, another domain,
# or flipping one game without a release:
#   before its cutover   GAME_URL_NOUL_WHO=https://guess-who.jevplay.games   (what the default already does)
#   to flip it early     GAME_URL_NOUL_WHO=https://noul-who.jevplay.games
# A key set under the old name (GAME_URL_GUESS_WHO) is still honoured while the row has legacySlug.
# GAME_URL_TIC_TAC_TYPED=http://localhost:8787
# GAME_URL_CHOICE_FOUR=
# GAME_URL_TYPECHECKERS=
# GAME_URL_BOX_SCORE=
# GAME_URL_NOUL_WHO=
# GAME_URL_TYPECRACK=
# GAME_URL_SAFESWEEP=
# GAME_URL_TYPEDOKU=
# GAME_URL_SLIDE_SCORE=
